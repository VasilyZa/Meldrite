{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact symbol ownership and implementation evidence",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["symbolId", "adapterFile", "serviceOwner", "capability", "status", "evidenceIds"],
        "properties": {
          "symbolId": {"type": "string", "minLength": 1},
          "adapterFile": {"type": "string", "minLength": 1},
          "serviceOwner": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "status": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "NOT_APPLICABLE"]},
          "reason": {"type": "string", "minLength": 1},
          "failureContract": {"type": "string", "minLength": 1},
          "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "implementation": {"type": "object", "required": ["owner", "name", "descriptor", "kind", "classFile", "classSha256", "sourceSha256"]}
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["SUPPORTED", "PARTIAL"]}}}, "then": {"required": ["implementation"], "properties": {"evidenceIds": {"minItems": 1}}}},
          {"if": {"properties": {"status": {"const": "PARTIAL"}}}, "then": {"required": ["limits"]}},
          {"if": {"properties": {"status": {"enum": ["UNSUPPORTED", "NOT_APPLICABLE"]}}}, "then": {"required": ["reason", "failureContract"]}}
        ]
      }
    }
  },
  "$comment": "BindingVerifier and ContractAudit also enforce classfile linkage, exact symbol coverage, provider provenance, current source/class/report hashes, and passing named behavior/regression testcases. Schema alone never establishes compatibility."
}
