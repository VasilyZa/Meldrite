{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavioral capability status",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entries": {"type": "object", "additionalProperties": {
      "type": "object",
      "required": ["status", "evidenceIds"],
      "properties": {
        "status": {"enum": ["SUPPORTED", "PARTIAL", "UNSUPPORTED", "NOT_APPLICABLE"]},
        "reason": {"type": "string", "minLength": 1},
        "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PARTIAL"}}}, "then": {"required": ["limits"]}},
        {"if": {"properties": {"status": {"enum": ["UNSUPPORTED", "NOT_APPLICABLE"]}}}, "then": {"required": ["reason"]}},
        {"if": {"properties": {"status": {"enum": ["SUPPORTED", "PARTIAL"]}}}, "then": {"properties": {"evidenceIds": {"minItems": 1}}}}
      ]
    }}
  },
  "$comment": "A domain cannot be SUPPORTED while one of its server-owned symbols remains PARTIAL or UNSUPPORTED."
}
